# Assistant (Milestones 1-2): text-first loop + one read-only k8s tool.
FROM python:3.12-slim

RUN pip install --no-cache-dir fastapi "uvicorn[standard]" httpx kubernetes python-multipart prometheus-client \
 && useradd --uid 10001 --user-group --shell /usr/sbin/nologin app \
 && mkdir -p /var/log/assistant && chown 10001:10001 /var/log/assistant

WORKDIR /app
COPY --chown=10001:10001 server.py tools.py k8sutil.py observability.py knowledge.py agent.py pipeline.py voice.py actions.py memory.py ui.py llm_metrics.py tts_cache.py /app/

USER 10001
EXPOSE 8080
ENTRYPOINT ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8080"]
