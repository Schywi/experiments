# Assistant (Milestones 1-2): text-first loop + one read-only k8s tool.
FROM python:3.12-slim

RUN pip install --no-cache-dir fastapi "uvicorn[standard]" httpx kubernetes python-multipart prometheus-client neo4j \
 && useradd --uid 10001 --user-group --shell /usr/sbin/nologin app \
 && mkdir -p /var/log/assistant && chown 10001:10001 /var/log/assistant

WORKDIR /app
# Copy every module so a new one (provenance.py, laya_planner.py, ...) cannot be
# silently omitted -- the explicit list drifted and broke the image.
COPY --chown=10001:10001 *.py /app/

USER 10001
EXPOSE 8080
ENTRYPOINT ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8080"]
