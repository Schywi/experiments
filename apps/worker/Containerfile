FROM docker.io/rust:1.86.0-alpine3.21 AS build
RUN rustup target add x86_64-unknown-linux-musl
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
RUN mkdir src && printf 'fn main() {}\n' > src/main.rs && cargo build --release --target x86_64-unknown-linux-musl
COPY src ./src
RUN cargo build --release --target x86_64-unknown-linux-musl

FROM scratch
COPY --from=build /src/target/x86_64-unknown-linux-musl/release/worm-worker /worm-worker
USER 65532:65532
ENTRYPOINT ["/worm-worker"]
