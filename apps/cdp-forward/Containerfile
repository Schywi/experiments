# The forwarding sidecar for the browser sandbox. Its only job is to republish a
# loopback listener on the pod IP, so the image stays static and tiny.
FROM docker.io/library/golang:1.26 AS build
WORKDIR /src
COPY go.mod ./
COPY main.go ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/cdp-forward .

FROM scratch
COPY --from=build /out/cdp-forward /cdp-forward
USER 65532:65532
ENTRYPOINT ["/cdp-forward"]
