# syntax=docker/dockerfile:1
# Docker Hub's maintained Elixir image supplies the pinned BEAM runtime used
# for both dependency compilation and execution.
FROM docker.io/hexpm/elixir:1.16.3-erlang-26.2.5-debian-bookworm-20260610-slim AS build

WORKDIR /app
ENV MIX_ENV=prod \
    MIX_HOME=/app/.mix

RUN mkdir -p "$MIX_HOME" && mix local.hex --force && mix local.rebar --force

COPY mix.exs mix.lock ./
RUN mix deps.get --only prod && mix deps.compile

COPY config ./config
COPY lib ./lib
RUN mix compile

FROM docker.io/hexpm/elixir:1.16.3-erlang-26.2.5-debian-bookworm-20260610-slim

WORKDIR /app
ENV MIX_ENV=prod \
    PORT=4000 \
    MIX_HOME=/app/.mix

COPY --from=build /app /app

RUN chmod -R a+rX /app/.mix /app/deps /app/_build /app/config /app/lib

USER 1000:1000
EXPOSE 4000
CMD ["mix", "run", "--no-halt"]
