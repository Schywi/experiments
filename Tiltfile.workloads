# Workloads are registered immediately and wait for the explicit platform
# validation resource before their first deployment.

WORM_NAMESPACE = "worm-lab"
IMAGE_BUILD = "scripts/build-and-import-image.sh"

custom_build(
    "worm-controller:tilt",
    IMAGE_BUILD + " \"$EXPECTED_REF\" apps/controller",
    deps=["apps/controller", IMAGE_BUILD],
    disable_push=True,
)

custom_build(
    "worm-regression:tilt",
    IMAGE_BUILD + " \"$EXPECTED_REF\" apps/regression",
    deps=["apps/regression", IMAGE_BUILD],
    disable_push=True,
)

custom_build(
    "worm-worker:tilt",
    IMAGE_BUILD + " \"$EXPECTED_REF\" apps/worker",
    deps=["apps/worker", IMAGE_BUILD],
    disable_push=True,
)

k8s_yaml(helm("apps/controller/chart", name="worm-controller", namespace=WORM_NAMESPACE))
k8s_resource("worm-controller", resource_deps=["platform-validate"])

k8s_yaml(helm("apps/regression/chart", name="worm-regression", namespace=WORM_NAMESPACE))
k8s_resource("regression", resource_deps=["platform-validate"])

k8s_yaml(helm("config/vector", name="worm-vector", namespace=WORM_NAMESPACE))
k8s_resource("vector", resource_deps=["platform-validate", "regression"])

k8s_yaml(helm("apps/worker/chart", name="worm-worker", namespace=WORM_NAMESPACE))
k8s_resource("worm-worker", resource_deps=["platform-validate", "worm-controller", "vector"])

local_resource(
    "worm-lab",
    cmd="true",
    resource_deps=["worm-controller", "regression", "vector", "worm-worker"],
)
