
# Dolt database files (added by bd init)
.beads/
.dolt/
*.db

# Local planning and machine-specific configuration
docs/
/cv/
# Everything under .agents/ is local agent state — except the skills, which are
# playbooks meant to travel with the repository (see .agents/skills/*/SKILL.md).
.agents/*
!.agents/skills/
# The blogging skill stays local; it is not part of this repository's playbook.
.agents/skills/blogging/
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.kubeconfig
kubeconfig*
secrets*.yaml
secrets*.yml
**/secrets/

# Beads / Dolt files (added by bd init)
.beads-credential-key
.beads/proxieddb/
*.gate.lock*

# Python bytecode caches (apps/models/* are Python)
__pycache__/
*.pyc

# Handoff notes for the sandbox-console commits; never published.
commit_message.txt
commit_message.sh

# Handoff notes for a specialised agent; never published.
handoff/
docs/handoff/

# Exported session transcript (markdown, written by the agent host); local only.
session-*.md

# Archives: sandbox-console ships as a tracked directory; the zip is a stale duplicate.
*.zip

# Private keys, at any depth — both swap labs generate their own.
id_ed25519
id_ed25519*

# Lab artefacts: VM images, caches and serial logs are regenerated, results/ is evidence and stays.
config/swap-lab/runs/
config/swap-lab/seed/
config/swap-lab/*.img
config/swap-lab/*.img.*
config/swap-lab/serial.log*
config/vm-swap-lab/runs/
config/vm-swap-lab/seed/
config/vm-swap-lab/cache/
config/vm-swap-lab/*.img
config/vm-swap-lab/*.img.*
config/vm-swap-lab/serial.log*
config/vm-swap-lab/base.img.url

# Quartz site: build artefact, assembled by scripts/site-sync.sh
site/content/
site/public/
node_modules/

# Quartz framework tree: fetched from the pinned release by site/bootstrap.sh
site/quartz/
site/.upstream/
