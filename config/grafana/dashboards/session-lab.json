{
  "uid": "session-lab",
  "title": "session-lab — session lifecycle and resources",
  "tags": [
    "session-lab",
    "sandbox",
    "phase-8"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Session throughput (per second, by outcome)",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(session_lab_sessions_total[$__rate_interval]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Concurrency — active and waiting sessions",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "session_lab_sessions_active",
          "legendFormat": "active"
        },
        {
          "refId": "B",
          "expr": "session_lab_sessions_waiting",
          "legendFormat": "waiting"
        },
        {
          "refId": "C",
          "expr": "session_lab_pool_ready",
          "legendFormat": "pool ready"
        },
        {
          "refId": "D",
          "expr": "session_lab_pool_desired",
          "legendFormat": "pool desired"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Queue wait — claim create to Ready (p50/p95/p99)",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 0,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(session_lab_queue_wait_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(session_lab_queue_wait_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(session_lab_queue_wait_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Acquisition — arrival to Ready, by launch type",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 0,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le, launch_type) (rate(session_lab_acquire_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50 {{launch_type}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, launch_type) (rate(session_lab_acquire_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95 {{launch_type}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Hold duration by length bucket (p50)",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 0,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le, bucket) (rate(session_lab_hold_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{bucket}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Reset, release and resume cost",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 0,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(session_lab_reset_seconds_bucket[$__rate_interval])))",
          "legendFormat": "reset p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(session_lab_reset_seconds_bucket[$__rate_interval])))",
          "legendFormat": "reset p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(session_lab_release_seconds_bucket[$__rate_interval])))",
          "legendFormat": "release p50"
        },
        {
          "refId": "D",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(session_lab_resume_seconds_bucket[$__rate_interval])))",
          "legendFormat": "resume p50"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Failures by outcome (per second, excluding success)",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(session_lab_sessions_total{outcome!=\"success\"}[$__rate_interval]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU throttled versus the template's CPU limit",
      "description": "Throttled seconds per second, with the limit the sandbox was held to. A non-zero line next to a limit means the session's latency is the limit's, not the workload's.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(session_lab_throttled_seconds_total[$__rate_interval]))",
          "legendFormat": "throttled seconds/s"
        },
        {
          "refId": "B",
          "expr": "session_lab_template_cpu_limit_cores",
          "legendFormat": "cpu limit (cores)"
        },
        {
          "refId": "C",
          "expr": "sum(rate(session_lab_cpu_seconds_total[$__rate_interval]))",
          "legendFormat": "cpu used (cores)"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Working set peak per session (p50/p95)",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "fillOpacity": 0,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(session_lab_workingset_peak_bytes_bucket[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(session_lab_workingset_peak_bytes_bucket[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Boundaries — refusals, throttling, OOM, evictions by kind",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (increase(session_lab_boundaries_total[$__rate_interval]))",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Scaling — pool desired vs ready vs demand",
      "description": "Pending claims are the demand signal; target is what the autoscaler asked for after clamping to its configured min and max.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "session_lab_pool_desired",
          "legendFormat": "pool desired"
        },
        {
          "refId": "B",
          "expr": "session_lab_pool_ready",
          "legendFormat": "pool ready"
        },
        {
          "refId": "C",
          "expr": "session_lab_autoscaler_target_replicas",
          "legendFormat": "autoscaler target"
        },
        {
          "refId": "D",
          "expr": "session_lab_autoscaler_pending_claims",
          "legendFormat": "pending claims"
        },
        {
          "refId": "E",
          "expr": "session_lab_autoscaler_max_replicas",
          "legendFormat": "configured max"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Scale-out delay and replica changes",
      "description": "Time from a scale-out decision until the pool was ready and the queue empty, plus how often the autoscaler moved the replica count.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 0,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(session_lab_autoscaler_scale_out_seconds_bucket[$__rate_interval])))",
          "legendFormat": "scale-out p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(session_lab_autoscaler_scale_out_seconds_bucket[$__rate_interval])))",
          "legendFormat": "scale-out p95"
        },
        {
          "refId": "C",
          "expr": "sum by (direction) (rate(session_lab_autoscaler_changes_total[$__rate_interval]))",
          "legendFormat": "changes/s {{direction}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Scrape health — runner and autoscaler",
      "description": "up=0 means the exporter is not reachable, so every other panel on this dashboard is empty rather than zero. The runner is a host process on 192.168.0.28:9109; the autoscaler is the in-cluster deployment.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 48
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"session-lab.*\"}",
          "legendFormat": "{{job}} {{instance}}"
        }
      ],
      "id": 100
    },
    {
      "type": "timeseries",
      "title": "Boot spike — instances booting and cores they used",
      "description": "A cold Chromium spikes to hundreds of millicores. Overlapping spikes saturate the node while average CPU reads idle, which is what --boot-concurrency bounds.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 48
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "session_lab_instances_booting",
          "legendFormat": "booting"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(session_lab_instance_booting_cores_bucket[$__rate_interval])))",
          "legendFormat": "boot cores p95"
        }
      ],
      "id": 101
    },
    {
      "type": "timeseries",
      "title": "Boot duration (p50/p95)",
      "description": "Time from sandbox binding to browser Ready. A cold start has measured 100-140 s on a saturated node.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 56
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(session_lab_boot_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(session_lab_boot_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ],
      "id": 102
    },
    {
      "type": "timeseries",
      "title": "Per-session task time (p50/p95)",
      "description": "Main-thread time the page cost inside one browser context. This is the number that says whether the workload rendered or sat idle.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 56
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(session_lab_session_task_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(session_lab_session_task_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ],
      "id": 103
    },
    {
      "type": "timeseries",
      "title": "JS heap per session (p95)",
      "description": "Heap used by one context's page. It separates a session that rendered from one that never pulled its script.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 64
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(session_lab_session_js_heap_bytes_bucket[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ],
      "id": 104
    },
    {
      "type": "timeseries",
      "title": "Node CPU in use (cores)",
      "description": "What the host sampler saw while the run executed. The template carries no CPU limit, so a browser bursts to whatever is free.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 64
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "session_lab_node_cpu_cores",
          "legendFormat": "cores used"
        }
      ],
      "id": 105
    },
    {
      "type": "timeseries",
      "title": "OOM kills",
      "description": "A killed sandbox takes every context inside it. No OOM kills plus empty panels elsewhere usually means the run never started.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 72
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(session_lab_oom_kills_total[$__rate_interval]))",
          "legendFormat": "oom kills"
        }
      ],
      "id": 106
    },
    {
      "type": "timeseries",
      "title": "Autoscaler pool — desired, ready and bounds",
      "description": "What the autoscaler reports for the pool it watches. min/max are its configured bounds; desired and ready are the live replica counts.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 72
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "session_lab_autoscaler_pool_desired",
          "legendFormat": "desired"
        },
        {
          "refId": "B",
          "expr": "session_lab_autoscaler_pool_ready",
          "legendFormat": "ready"
        },
        {
          "refId": "C",
          "expr": "session_lab_autoscaler_min_replicas",
          "legendFormat": "min"
        },
        {
          "refId": "D",
          "expr": "session_lab_autoscaler_max_replicas",
          "legendFormat": "max"
        }
      ],
      "id": 107
    }
  ]
}
